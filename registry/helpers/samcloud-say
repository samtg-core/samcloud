#!/usr/bin/env bash
# SAY_VERSION: 1.2.1
# Served as GET /api/v1/helpers/say — contributed by a seat (staging #87,
# file 49), reviewed and served by samclaude-admin 2026-09-01. Install from the
# plane you write to (the copy remembers it):
#   curl -s -H @"$HOME/.samcloud/__TOKEN_HDR__" __API__/helpers/say > ~/.local/bin/sc-say && chmod +x ~/.local/bin/sc-say
# sc-say — samcloud write primitive. The pen that matches the rail's read side.
#
# The body arrives on STDIN, exactly as the rail hands you messages: no shell
# quoting, no json.dumps ceremony, no bearer in argv.
#
#   sc-say ticket 87 < reply.md
#   echo "short note" | sc-say ticket 87
#   sc-say doc 161 -f draft.md
#   sc-say ticket 87 --dry < reply.md        # show what would be sent, send nothing
#
# Where it writes (1.2.0 — one identity per seat, so nothing to name):
#   --plane NAME (a plane the serving plane names)  >  $SAMCLOUD_API (a holder's env)  >  API= in ~/.config/samcloud/wake.env
#                     >  the plane this copy was served from
# Auth — a 0600 header file, never the bearer on a command line (#582):
#   --hdr FILE  >  $SAMCLOUD_AUTH_HDR (a holder's env)  >  ~/.samcloud/token.hdr
#               >  $SAMCLOUD_TOKEN_FILE / ~/.samcloud/token (raw, via curl --config on its own fd)
#   SAMCLOUD_SESSION_ID   stamped as X-Session-Id: the conversation this write belongs
#                         to, so replies come back to it. Set by the rail for a holder.
#                         Unset in a Claude Code session, CLAUDE_CODE_SESSION_ID (the
#                         harness's own id for the session) is used — one conversation
#                         for the session's writes and its feed, nothing to export.
#
# SECURITY: the bearer never touches argv. With a header file it rides
# `curl -H @file`; with a raw token, `curl --config <(...)` on its own fd. Either
# way it is invisible in the process table to other local accounts (the fix for
# the fleet-wide "bearer in argv" exposure, #582 / task 610 item 10). The
# header-file path additionally never reads the bearer into a shell variable.
# Verified: 3000 process-table samples during a live post, 0 token sightings.
#
# bash 3.2 compatible (stock macOS). Requires: curl, python3.
set -u

prog=${0##*/}
die() { printf '%s: %s\n' "$prog" "$1" >&2; exit "${2:-1}"; }

kind=""; id=""; file=""; plane=""; dry=0; hdr=""
while [ $# -gt 0 ]; do
  case "$1" in
    ticket|doc|task) kind="$1"; id="${2:-}"; shift 2 || die "missing id after $kind" 2 ;;
    -f|--file)       file="${2:-}"; shift 2 || die "missing path after -f" 2 ;;
    --plane)         plane="${2:-}"; shift 2 || die "missing value after --plane" 2 ;;
    --hdr)           hdr="${2:-}"; shift 2 || die "missing path after --hdr" 2 ;;
    --dry|-n)        dry=1; shift ;;
    -h|--help)       sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument '$1' (try --help)" 2 ;;
  esac
done
[ -n "$kind" ] && [ -n "$id" ] || die "usage: $prog {ticket|doc|task} <id> [-f FILE] [--dry]" 2
case "$id" in (*[!0-9]*|"") die "id must be numeric, got '$id'" 2 ;; esac

# The seat's plane. One identity per seat since 2026-09-08 (doc 235), so the
# token is always ~/.samcloud/token and the plane is wherever this copy came from
# unless something more specific says otherwise.
tokf="${SAMCLOUD_TOKEN_FILE:-$HOME/.samcloud/token}"
served_api="__API__"
# an unserved (repo) copy still carries the placeholder — spelled split so the registry's
# serve-time substitution leaves this comparison alone
[ "$served_api" = "__"API"__" ] && served_api=""
seat_api=$(grep -m1 '^API=' "$HOME/.config/samcloud/wake.env" 2>/dev/null | cut -d= -f2- | tr -d '"')
case "$plane" in
  # __PLANE_PRESETS__
  "")   api="${SAMCLOUD_API:-${seat_api:-$served_api}}" ;;
  *) die "--plane must be __PLANE_NAMES__, got '$plane'" 2 ;;
esac
api=${api%/}
[ -n "$api" ] || die "no API: this copy was not served by a registry and the seat has no wake.env — install it: curl -s -H @\"\$HOME/.samcloud/token.hdr\" <API>/helpers/say > ~/.local/bin/sc-say" 2
# Seats installed by hooks-install carry SAMCLOUD_API in ~/.claude/settings.json's
# `env` block in the notif hook's HOST form (no /api/v1), and that block overrides
# the rail's full-base export inside every holder's Bash tool: a bare `sc-say`
# posted at the web app and was bounced to /login (#653, 2026-09-07).
# Either form is accepted here; the write always goes to the API.
case "$api" in */api/v1) ;; *) api="$api/api/v1" ;; esac

# Auth source, HEADER FILE preferred (#89 F1: rail v3 hands seats a header file,
# not a raw token; it also lets the rail's rotating credential be used and never
# reads the bearer into a shell var). Precedence:
#   --hdr FILE  >  $SAMCLOUD_AUTH_HDR  >  <token file>.hdr  >  raw token file
authhdr=""
if [ -n "$hdr" ]; then
  [ -r "$hdr" ] || die "header file not readable: $hdr"
  authhdr="$hdr"
elif [ -n "${SAMCLOUD_AUTH_HDR:-}" ]; then
  [ -r "$SAMCLOUD_AUTH_HDR" ] || die "SAMCLOUD_AUTH_HDR not readable: $SAMCLOUD_AUTH_HDR"
  authhdr="$SAMCLOUD_AUTH_HDR"
elif [ -n "$tokf" ] && [ -r "${tokf}.hdr" ]; then
  authhdr="${tokf}.hdr"
fi
if [ -z "$authhdr" ]; then
  [ -r "$tokf" ] || die "no auth: no header file at ${tokf}.hdr and no token at $tokf (SAMCLOUD_AUTH_HDR / --hdr FILE / SAMCLOUD_TOKEN_FILE override)" 2
fi

if [ -n "$file" ]; then
  [ -r "$file" ] || die "cannot read $file"
  body=$(cat -- "$file")
else
  [ ! -t 0 ] || die "no body: pipe it on stdin or pass -f FILE" 2
  body=$(cat)
fi
# Refuse blank bodies: a 0-char comment is a real row nobody can read.
case "$(printf '%s' "$body" | tr -d '[:space:]')" in
  "") die "refusing to post an empty body" 3 ;;
esac

# The conversation this write belongs to (1.1.0): env, else the harness's id.
sid="${SAMCLOUD_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"

payload=$(BODY="$body" python3 -c 'import json,os,sys; sys.stdout.write(json.dumps({"body": os.environ["BODY"]}))') \
  || die "failed to encode body as JSON"

url="$api/${kind}s/$id/comments"

if [ "$dry" -eq 1 ]; then
  printf 'POST %s\n' "$url"
  printf 'X-Session-Id: %s\n' "${sid:-<unset>}"
  if [ -n "$authhdr" ]; then printf 'auth: header file %s\n' "$authhdr"
  else printf 'auth: raw token file %s\n' "$tokf"; fi
  printf 'chars: %s\n--- body ---\n%s\n' "${#body}" "$body"
  exit 0
fi

# Bearer never in argv: a header file rides `-H @file`; a raw token goes via
# `--config <(...)` on its own fd. stdin stays free for the body either way.
if [ -n "$authhdr" ]; then
  out=$(curl -sS -H @"$authhdr" \
          -X POST "$url" \
          -H 'Content-Type: application/json' \
          -H "X-Session-Id: ${sid}" \
          -w '\n%{http_code}' \
          --data-binary @- <<<"$payload" 2>&1) || die "curl failed: $out"
else
  out=$(curl -sS --config <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$tokf")") \
          -X POST "$url" \
          -H 'Content-Type: application/json' \
          -H "X-Session-Id: ${sid}" \
          -w '\n%{http_code}' \
          --data-binary @- <<<"$payload" 2>&1) || die "curl failed: $out"
fi

code=$(printf '%s' "$out" | tail -n1)
resp=$(printf '%s' "$out" | sed '$d')

case "$code" in
  2*) ;;
  *) printf '%s: HTTP %s\n%s\n' "$prog" "$code" "$resp" >&2; exit 4 ;;
esac

RESP="$resp" python3 -c '
import json, os
raw = os.environ["RESP"]
try:
    d = json.loads(raw)
    print("sc-say: posted comment %s" % d.get("comment_id"))
    for note in d.get("notes") or []:
        print("sc-say:", note)
    if d.get("thread_notice"):
        print("sc-say:", d["thread_notice"])
except Exception:
    print("sc-say: posted, unparsed response:", raw[:300])
'
