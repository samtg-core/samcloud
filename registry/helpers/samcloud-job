#!/usr/bin/env python3
# JOB_VERSION: 1.1.0
# Served as GET /api/v1/helpers/job. Install from the plane you call from:
#   curl -s -H @"$HOME/.samcloud/__TOKEN_HDR__" __API__/helpers/job > ~/.local/bin/sc-job && chmod +x ~/.local/bin/sc-job
"""sc-job — call a service on the plane: submit a job, wait for it, keep what it made.

    sc-job list                                         services you can see: id, health, address, what it does
    sc-job call <service id> <submit path> [BODY] [--store GROUP] [--ttl S] [--out DIR] [--no-wait] [--json]
                                                        BODY is JSON, @file or - (stdin); default {}
    sc-job fetch <service id> <job> [--grant ID] [--out DIR] [--json]
                                                        wait for a job you submitted, download it, revoke --grant
    sc-job status <service id> <job>                    the job as the service reports it (raw JSON)
    sc-job cancel <service id> <job>                    withdraw a queued job, or delete a finished one
    sc-job check <service id>… | --all [--submit PATH] [--json]
                                                        does the service meet the standard (tools.md,
                                                        "The standard"; doc 793)? one line per check
                                                        (fetch, status and cancel take --poll PATH if not /jobs/<job>)

    sc-job call wafer-services/scene-render /render '{"scene":"<id>","mode":"quick"}' --store projects

`call` finds the service's address in `GET /services/{id}`, submits BODY to
<submit path> there, and polls until the job ends. It keeps waiting through
dropped connections and 5xx answers, backing off up to a minute. On `done` it
downloads every file the job's `results` name into --out (default ./<job>),
and prints the files, then each plane file you now own: its role, its id and
the markdown that embeds it. Those are already your files on the plane; paste
the markdown, don't upload the downloads again.

The job ends `done`, or as a failure: `failed`, `cancelled` (or `canceled`),
`error` or `expired`. `queued` and `running` are waited out. Any other status
is named once on stderr and waited out for as long as the job keeps giving
answers it hasn't given before: any field counts (stage, progress, percent,
position), except clock-like ones (`*_at`, `*_s`, `updated`, `heartbeat`, …).
After 20 polls in a row with nothing new, or with no status at all, or 5 polls
in a row that answer an error or no JSON, sc-job stops waiting (exit 2) and
leaves the job and its grant alone, printing how to resume. Two statuses that
alternate stop too, once both have been seen.

--store GROUP mints a grant for that service and that plane group (one you
edit, from `GET /groups`), adds it to BODY as "grant", and revokes it when the
job ends. --ttl is the grant's life (default 7200 s). With --no-wait, or if you
stop waiting with Ctrl-C, the job carries on and the grant stays live until its
ttl so the uploads still land; sc-job prints the `sc-job fetch … --grant ID`
line that resumes, downloads and then revokes it. SIGTERM or SIGHUP revokes the
grant (the job's uploads will then fail) and prints the fetch line; so does a
Ctrl-C that comes with one, if the stop is there when the Ctrl-C note starts
(a stop after that is dropped, so what was printed holds). If a revoke fails it says so,
prints the command, and carries on.

What a service has to answer (tools.md, "Register a service"): the submit reply
names `job` (and may name `poll`, else /jobs/<job>); the poll answers `status`,
with `error` when it failed; `results` names each file by its path under
<poll>/files/; `plane_files` holds what it stored on your grant; DELETE on the
poll path withdraws the job.

`check` reads the service's entry and probes it as a caller would. The
service's kind is the capability word it declares: compute-job, compute-sync,
no-compute or pointer. The kind decides which lines are critical. A critical line
is PASS or FAIL; any other line is PASS or `note`; `?` means a probe can't tell.
  kind         exactly one of the four words (critical)
A pointer is checked only for being reachable:
  address      external_url, with no token and redirects followed, answers with a
               page or a sign-in challenge (2xx, 3xx, 401, 403); a 404 or a 5xx
               isn't a page a person can open (critical). A description is a note.
For every other kind, critical:
  address      an https external_url
  docs         docs_endpoint opens: a plane doc, a path on the service, or another
               https address. Tried without your token first; with it only on a
               401/403, and only to the plane or the service's own address
  auth         a GET with no token is refused (401 or 403); a 2xx fails; anything
               else is `?`
  own id       compute kinds, and an undeclared entry that has leased: judged by
               the current evidence (GET /leases?service_id=). The newest lease is
               held as the service, and one has been granted and released as it;
               older rows held as a user are history. A newest lease held as a user
               fails; so does no lease at all on a device whose leases you can see.
               Leases you can't see, or none granted and released yet, are `?`
               (unverified). A no-compute entry that has leased gets a note.
  submit       with --submit PATH: an empty body ({}), sent with your token, is
               refused as input: 400 or 422 with a JSON error. A 404, 405, 401 or
               403 means the operation or your access isn't there, and fails. A 2xx
               means a job started from nothing: sc-job withdraws it at once with
               DELETE on its poll path (stops wait until that's sent) and says if
               that failed (only a 2xx counts as withdrawn). Critical for compute-job (`?` without --submit), a note
               for the others.
  grant        compute-job: results go to the caller's grant. Not visible from
               outside, so always `?`: the guide should say.
and notes:
  description  40 characters or more
  capabilities at least one besides the kind
  version      set (any value for now; <semver>+<sha> later)
  health       reported in the last 30 minutes (not `stale`, not never)
It writes nothing except that one POST of {}. Each probe, headers and body, gets
15 s of wall time (SC_JOB_PROBE_S); --all checks 8 services at once, and an entry
it can't read gets its own FAIL line. Check as a plain seat, the caller the
standard is for, not as admin. Exit 0 when no critical line fails, 1 when one does.

Exit: 0 done; 1 failed/cancelled/expired; 2 usage, HTTP or interrupted.

Where it calls (as sc-say): --plane NAME (a plane the serving plane names) > $SAMCLOUD_API
  > API= in ~/.config/samcloud/wake.env > the plane this copy was served from. https, or loopback.
Auth — a 0600 header file, never the bearer on a command line (#582):
  --hdr FILE (must exist) > $SAMCLOUD_AUTH_HDR > ~/.samcloud/token.hdr
The bearer goes only to the plane and to the service's own https address, and is
never printed. Nor is a grant: a grant secret in what sc-job prints (a service's
error that echoes the request, --json, status) shows as sc_grant_[redacted]. API calls follow a redirect only to the same origin. A download
may follow an https redirect to another host, without the bearer; a redirect to
plain http is refused. Python 3 standard library only.
"""
import argparse
import http.client
import json
import os
import pathlib
import re
import shlex
import signal
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

PROG = "sc-job"
OK = ("done",)
FAILED = ("failed", "cancelled", "canceled", "error", "expired")
WAITING = ("queued", "running")
UNKNOWN_WARN_AFTER = 3     # polls with an unfamiliar status before it is named
UNKNOWN_LIMIT = 20         # polls in a row with no status, or an unfamiliar one bringing no new answer
SEEN_LIMIT = 4096          # distinct answers remembered per wait; past that, it starts again
# Fields that change on every poll whether or not the job moves: not movement.
CLOCK = re.compile(r"(_at|_s|_ms|_ts)$|^(time|timestamp|now|ts|updated|heartbeat|elapsed|eta|expires)$", re.I)
POLL_BAD_LIMIT = 5         # polls in a row answering an error or no JSON
EMBED_LIMIT = 24           # plane files whose record sc-job reads for their markdown
try:
    _PLANES = json.loads('__PLANES_JSON__')
except ValueError:          # an unrendered copy, run from a checkout
    _PLANES = {}
_SERVED_API = "__API__"
JOB_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
LOOPBACK = ("localhost", "127.0.0.1", "::1")
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)?")
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")
# The plane mints "sc_grant_" + secrets.token_urlsafe(32): always 43 of [A-Za-z0-9_-]. Only that shape
# is hidden, so a file named sc_grant_report-2026.txt prints as it is.
GRANT_SECRET = re.compile(r"sc_grant_[A-Za-z0-9_-]{43}")


def _pair(name, default):
    try:
        a, b = (float(x) for x in os.environ.get(name, default).split(","))
        return a, b
    except ValueError:
        return tuple(float(x) for x in default.split(","))


# Seconds: poll back-off (start, ceiling) and retry back-off (start, ceiling). Tunable for tests.
POLL_MIN, POLL_MAX = _pair("SC_JOB_POLL_S", "5,15")
RETRY_MIN, RETRY_MAX = _pair("SC_JOB_RETRY_S", "2,60")
_UMASK = os.umask(0)
os.umask(_UMASK)
FILE_MODE = 0o666 & ~_UMASK          # what a downloaded file gets: the umask's, not mkstemp's 0600


class CallError(Exception):
    """A call that could not be made or was refused; the message is for the user."""


class RedirectRefused(Exception):
    pass


class PollLost(Exception):
    """Polling can't tell what the job is doing; the job may still be running."""


class Stopped(SystemExit):
    """SIGTERM or SIGHUP: unwind through every finally, exit 2."""

    def __init__(self, signame):
        super().__init__(2)
        self.signame = signame


class Redacted:
    """A text stream that never shows a grant secret. Services echo requests in errors and job
    records, and agents post terminal output on the plane."""

    def __init__(self, stream):
        self._stream = stream

    def write(self, text):
        return self._stream.write(GRANT_SECRET.sub("sc_grant_[redacted]", text))

    def __getattr__(self, name):
        return getattr(self._stream, name)


def clean(value, limit=300):
    """An untrusted string, safe to print: escape sequences and control characters removed, and any
    grant secret hidden before the cut, so a secret straddling it can't print in part."""
    s = GRANT_SECRET.sub("sc_grant_[redacted]", CONTROL.sub(" ", ANSI.sub("", str(value))))
    return s[:limit] + ("…" if len(s) > limit else "")


def die(msg, code=2):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    print(msg, file=sys.stderr, flush=True)


def is_loopback(url):
    return urllib.parse.urlsplit(url).hostname in LOOPBACK


def plane_api(plane):
    if plane:
        if plane not in _PLANES:
            die(f"unknown plane {plane!r} (this copy knows: {', '.join(_PLANES) or 'none'})")
        api = _PLANES[plane]
    else:
        seat = ""
        try:
            for line in (pathlib.Path.home() / ".config/samcloud/wake.env").read_text().splitlines():
                if line.startswith("API="):
                    seat = line[4:].strip().strip('"')
                    break
        except OSError:
            pass
        served = "" if _SERVED_API == "__" + "API" + "__" else _SERVED_API
        api = os.environ.get("SAMCLOUD_API") or seat or served
    if not api:
        die("no API: this copy was not served by a registry and the seat has no wake.env; "
            "install it with: curl -s -H @\"$HOME/.samcloud/token.hdr\" <API>/helpers/job > ~/.local/bin/sc-job")
    api = api.rstrip("/")
    scheme = urllib.parse.urlsplit(api).scheme
    if scheme != "https" and not (scheme == "http" and is_loopback(api)):
        die(f"refusing to send your token to the plane over {scheme or 'no scheme'}: {clean(api)}")
    return api if api.endswith("/api/v1") else api + "/api/v1"


def bearer(hdr):
    """(value, path) of the seat's Authorization header. An explicit --hdr must exist: no fallback."""
    if hdr:
        if not (os.path.isfile(hdr) and os.access(hdr, os.R_OK)):
            die(f"no readable header file at {hdr}")
        candidates = [hdr]
    else:
        candidates = [os.environ.get("SAMCLOUD_AUTH_HDR", ""),
                      str(pathlib.Path.home() / ".samcloud" / "__TOKEN_HDR__"),
                      str(pathlib.Path.home() / ".samcloud" / "token.hdr")]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.R_OK):
            for line in pathlib.Path(c).read_text().splitlines():
                name, _, value = line.partition(":")
                if name.strip().lower() == "authorization" and value.strip():
                    return value.strip(), c
            if hdr:
                die(f"{hdr} holds no Authorization line")
    die("no samcloud header file (--hdr, SAMCLOUD_AUTH_HDR or ~/.samcloud/token.hdr)")


def origin(url):
    u = urllib.parse.urlsplit(url)
    return (u.scheme, u.netloc)


class ApiRedirects(urllib.request.HTTPRedirectHandler):
    """An API call follows a redirect only to its own origin."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if origin(newurl) != origin(req.full_url):
            raise RedirectRefused(f"refusing a redirect from {origin(req.full_url)[1]} to {clean(newurl, 120)}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


class DownloadRedirects(urllib.request.HTTPRedirectHandler):
    """A download may follow an https redirect to another host, without the bearer. Never to plain http."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        same = origin(newurl) == origin(req.full_url)
        if not same and urllib.parse.urlsplit(newurl).scheme != "https":
            raise RedirectRefused(f"refusing a download redirect to {clean(newurl, 120)}: not https")
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and not same:
            new.headers.pop("Authorization", None)
            new.unredirected_hdrs.pop("Authorization", None)
        return new


def refused_before_send(e):
    return isinstance(e, urllib.error.URLError) and isinstance(getattr(e, "reason", None), ConnectionRefusedError)


class Client:
    def __init__(self, api, auth, hdr_path=""):
        self.api, self.auth, self.hdr_path = api, auth, hdr_path
        self.api_opener = urllib.request.build_opener(ApiRedirects)
        self.dl_opener = urllib.request.build_opener(DownloadRedirects)
        self.anon_opener = urllib.request.build_opener()     # check's no-token probes: redirects followed
        self.allowed = {origin(api)}

    def revoke_hint(self, grant_id):
        return (f"curl -s -H @{shlex.quote(self.hdr_path or os.path.expanduser('~/.samcloud/token.hdr'))} "
                f"-X DELETE {shlex.quote(f'{self.api}/grants/{grant_id}')}")

    def call(self, method, url, body=None, *, tries=5, stream_to=None, what=None):
        """One call. tries=None retries for ever (polling); a POST is retried only when the
        connection was refused before anything was sent. Raises CallError."""
        if origin(url) not in self.allowed:
            raise CallError(f"refusing to send your token to {clean(urllib.parse.urlsplit(url).netloc)}")
        data = None if body is None else json.dumps(body).encode()
        label = what or f"{method} {url.split('?')[0]}"
        attempt, delay, streak = 0, RETRY_MIN, False
        while True:
            attempt += 1
            req = urllib.request.Request(url, data=data, method=method, headers={"Authorization": self.auth})
            if data is not None:
                req.add_header("Content-Type", "application/json")
            opener = self.dl_opener if stream_to is not None else self.api_opener
            try:
                with opener.open(req, timeout=300 if stream_to is not None else 60) as r:
                    if stream_to is not None:
                        return self._stream(r, stream_to)
                    payload = r.read()
                break
            except RedirectRefused as e:
                raise CallError(str(e))
            except urllib.error.HTTPError as e:
                retryable = (e.code >= 500 or e.code == 429) and method != "POST"
                reason = f"{e.code}: {self._error_text(e)}"
            except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
                reason = clean(getattr(e, "reason", None) or e.__class__.__name__ + (f" {e}" if str(e) else ""))
                retryable = method != "POST" or refused_before_send(e)
                if method == "POST" and not retryable:
                    raise CallError(f"{label}: the connection failed after sending ({reason}). It may have "
                                    f"reached the service: check before you send it again, so it doesn't run twice")
            if not retryable or (tries is not None and attempt >= tries):
                raise CallError(f"{label} → {reason}" + (f" (after {attempt} tries)" if attempt > 1 else ""))
            if not streak:
                note(f"{PROG}: {label} → {reason}; retrying" + (" until it answers" if tries is None else ""))
                streak = True
            time.sleep(delay)
            delay = min(RETRY_MAX, delay * 2)
        try:
            return json.loads(payload) if payload.strip() else {}
        except ValueError:
            raise CallError(f"{label} did not answer JSON")

    @staticmethod
    def _error_text(e):
        try:
            err = json.loads(e.read())
            msg = (err.get("error") or err.get("detail")) if isinstance(err, dict) else None
        except Exception:
            msg = None
        return clean(msg or e.reason)

    @staticmethod
    def _stream(r, dest):
        """Write the body to a temp file beside dest, then put it in place."""
        fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=".sc-job-")
        try:
            with os.fdopen(fd, "wb") as f:
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    f.write(chunk)
            # At EOF short of a Content-Length, http.client returns what came without raising, and
            # `length` is what's missing. A chunked body has no length (its framing ends it), and
            # any Content-Length beside it is ignored, as http.client ignores it.
            if getattr(r, "length", None):
                raise http.client.IncompleteRead(b"", r.length)
            os.chmod(tmp, FILE_MODE)
            os.replace(tmp, dest)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
        return dest


def service_base(c, service):
    s = c.call("GET", f"{c.api}/services/{urllib.parse.quote(service, safe='')}")
    url = (s.get("external_url") or "").rstrip("/")
    if not url:
        die(f"{clean(service)} has no external_url: it can't be called from here")
    if not callable_url(url):
        die(f"{clean(service)} answers at {clean(url)}; refusing to send your token over "
            f"{urllib.parse.urlsplit(url).scheme or 'no scheme'}")
    c.allowed.add(origin(url))
    return url


def callable_url(url):
    scheme = urllib.parse.urlsplit(url or "").scheme
    return bool(url) and (scheme == "https" or (scheme == "http" and is_loopback(url)))


def safe_path(path, what):
    """A path on the service: absolute, no scheme or host, no '..' segment."""
    if (not isinstance(path, str) or not path.startswith("/") or path.startswith("//")
            or "://" in path or "\\" in path or ".." in path.split("/") or "?" in path or "#" in path
            or CONTROL.search(path)):
        die(f"refusing an unexpected {what} from the service: {clean(path, 120)!r}")
    return path


def job_id(j):
    if not isinstance(j, str) or not JOB_ID.fullmatch(j):
        die(f"not a job id: {clean(j, 80)!r}")
    return j


def walk(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for v in value.values():
            yield from walk(v)
    elif isinstance(value, list):
        for v in value:
            yield from walk(v)


def result_files(j, base, poll):
    """Relative names of the files `results` names under <poll>/files/. A path that
    starts there and then leaves it is refused, not skipped."""
    prefix = poll.rstrip("/") + "/files/"
    out = []
    for s in walk(j.get("results")):
        if s.startswith(base + "/"):
            s = s[len(base):]
        if not s.startswith(prefix):
            continue
        rel = urllib.parse.unquote(s[len(prefix):])
        if not rel_ok(rel):
            die(f"refusing a file path outside the job's files: {clean(s, 120)!r}")
        if rel not in out:
            out.append(rel)
    return out


def rel_ok(rel):
    """Segments of printable text (so no NUL or other control character), none empty, `.` or
    `..`, none with a backslash. Spaces and non-ASCII letters are fine."""
    for seg in rel.split("/"):
        if not seg or seg in (".", ".."):
            return False
        if "\\" in seg:
            return False
        if not seg.isprintable():
            return False
    return True


def targets(rels, out):
    """Where each file goes, all checked before anything is fetched: inside --out,
    following any link already there."""
    out.mkdir(parents=True, exist_ok=True)
    root = out.resolve()
    plan = []
    for rel in rels:
        dest = (out / rel).resolve()
        if root not in dest.parents:
            die(f"refusing to write outside {out}: {rel!r}")
        plan.append((rel, dest))
    return plan


def download(c, base, poll, rels, out):
    for rel, dest in targets(rels, out):
        dest.parent.mkdir(parents=True, exist_ok=True)
        c.call("GET", f"{base}{poll.rstrip('/')}/files/{urllib.parse.quote(rel)}", stream_to=dest)


def flatten(value, role=""):
    if isinstance(value, bool):
        return
    if isinstance(value, int) or (isinstance(value, str) and value.isascii() and value.isdecimal()):
        yield clean(role or "file", 120), int(value)
    elif isinstance(value, dict):
        for k, v in value.items():
            yield from flatten(v, f"{role}/{k}" if role else str(k))
    elif isinstance(value, list):
        for i, v in enumerate(value):
            yield from flatten(v, f"{role}[{i}]")


def wait(c, base, poll, job):
    last, delay, bad = None, POLL_MIN, 0
    answers, stale, odd, warned = set(), 0, 0, False
    while True:
        try:
            j = c.call("GET", base + poll, tries=None, what=f"polling job {job}")
            if not isinstance(j, dict):
                raise CallError(f"polling job {job} did not answer a JSON object")
        except CallError as e:
            bad += 1
            if bad >= POLL_BAD_LIMIT:
                raise PollLost(f"{e} ({bad} polls in a row)")
            if bad == 1:
                note(f"{PROG}: {e}; trying again")
            time.sleep(min(RETRY_MAX, RETRY_MIN * 2 ** (bad - 1)))
            continue
        bad = 0
        status = j.get("status")
        now = (status, j.get("stage"), position(j))
        if now != last:
            progress(job, j)
            last, delay = now, POLL_MIN
        else:
            delay = min(POLL_MAX, delay + POLL_MIN)
        if status in OK + FAILED:
            return j
        if status in WAITING:
            stale = odd = 0
        else:
            odd += 1
            if odd >= UNKNOWN_WARN_AFTER and not warned:
                warned = True
                note(f"{PROG}: job {job} reports status {clean(status, 40)!r}, which sc-job doesn't know; "
                     f"still waiting for done, or one of {', '.join(FAILED)}")
            # An answer never seen before is movement, whichever field moved. One seen before isn't,
            # so a job flapping between two statuses ends too. No status is never movement.
            key = json.dumps(movement(j), sort_keys=True, default=str)
            if len(answers) >= SEEN_LIMIT:
                answers.clear()
            stale = 1 if status is not None and key not in answers else stale + 1
            answers.add(key)
            if stale >= UNKNOWN_LIMIT:
                raise PollLost(f"job {job} has answered " + ("no status" if status is None else
                               f"status {clean(status, 40)!r} with nothing new") + f" for {stale} polls")
        time.sleep(delay)


def movement(value):
    """The answer without its clock fields: what has to be new for a poll to count as movement."""
    if isinstance(value, dict):
        return {k: movement(v) for k, v in value.items() if not CLOCK.search(str(k))}
    if isinstance(value, list):
        return [movement(v) for v in value]
    return value


def position(j):
    return j.get("position") if j.get("position") is not None else j.get("gpu_position")


def progress(job, j):
    where = clean(j.get("stage") or j.get("status"), 80)
    pos = position(j)
    note(f"  {time.strftime('%H:%M:%S')} {job} {where}" + (f", position {clean(pos, 12)}" if pos else ""))


def embed(c, role, fid, look=True):
    """The markdown for one plane file: the plane's own, if it points at that file, else built here."""
    raw = f"/api/v1/files/{fid}/raw"
    f = {}
    if look:
        try:
            f = c.call("GET", f"{c.api}/files/{fid}", tries=1)
        except CallError:
            f = {}
    md = f.get("markdown") if isinstance(f, dict) else None
    if isinstance(md, str) and md.endswith(f"]({raw})") and md.isprintable() and len(md) <= 300:
        return md
    name = clean((f.get("name") if isinstance(f, dict) else None) or role.rsplit("/", 1)[-1], 80)
    name = name.replace("[", "(").replace("]", ")")
    image = str((f.get("content_type") if isinstance(f, dict) else "") or "").startswith("image/")
    return f"{'!' if image else ''}[{name}]({raw})"


def summary(c, j, job, out, rels):
    times = ", ".join(f"{k[:-2]} {clean(j[k], 20)} s" for k in ("waited_s", "render_s", "run_s")
                      if j.get(k) is not None)
    line = f"job {job}: {clean(j.get('status'), 40)}" + (f" · {times}" if times else "")
    if j.get("status") != "done" and j.get("error"):
        line += f" · {clean(j['error'])}"
    print(line)
    if rels:
        shown = ", ".join(rels[:6]) + (f", … ({len(rels)} in all)" if len(rels) > 6 else "")
        print(f"files in {out}/: {shown}")
    pf = list(flatten(j.get("plane_files")))
    if pf:
        print("plane files you own, already on the plane (paste the markdown; don't upload the downloads again):")
        for n, (role, fid) in enumerate(pf):
            print(f"  {role} {fid}  {embed(c, role, fid, look=n < EMBED_LIMIT)}")
    if j.get("plane_error"):
        print(f"plane upload: {clean(j['plane_error'])}")
    if j.get("expires"):
        print(f"kept on the service until {clean(j['expires'], 40)}")


def finish(c, a, base, poll, job, j):
    out = pathlib.Path(a.out or job)
    rels = []
    if j.get("status") == "done":
        rels = result_files(j, base, poll)
        download(c, base, poll, rels, out)
    if a.json:
        print(json.dumps(j, indent=1))
    else:
        summary(c, j, job, out, rels)
    return 0 if j.get("status") in OK else 1


def read_body(arg):
    if arg is None:
        return {}
    text = sys.stdin.read() if arg == "-" else (pathlib.Path(arg[1:]).read_text() if arg.startswith("@") else arg)
    try:
        return json.loads(text)
    except ValueError as e:
        die(f"BODY is not JSON: {e}")


QUIET = tuple(getattr(signal, n) for n in ("SIGTERM", "SIGHUP", "SIGINT") if hasattr(signal, n))


def revoke(c, grant):
    """Best effort, and not interruptible: further signals are ignored while it runs. A failed
    revoke is reported with the command, and the job's results still come back."""
    gid = grant["id"]
    saved = {s: signal.getsignal(s) for s in QUIET}
    for s in QUIET:
        signal.signal(s, signal.SIG_IGN)
    try:
        c.call("DELETE", f"{c.api}/grants/{urllib.parse.quote(str(gid), safe='')}", tries=3,
               what=f"revoking grant {clean(gid, 40)}")
    except CallError as e:
        note(f"{PROG}: could not revoke grant {clean(gid, 40)} ({e}). It expires at "
             f"{clean(grant.get('expires_at'), 40)}; to revoke it now:\n  {c.revoke_hint(gid)}")
    finally:
        for s, h in saved.items():
            signal.signal(s, h)


def fetch_hint(a, job, poll, grant=None):
    extra = f" --poll {shlex.quote(poll)}" if poll != f"/jobs/{job}" else ""
    if grant:
        extra += f" --grant {shlex.quote(str(grant['id']))}"
    return f"sc-job fetch {shlex.quote(a.service)} {job}{extra}"


def kept_note(c, a, job, poll, grant, why):
    note(f"\n{PROG}: {why}. Job {job} carries on at the service.")
    if grant:
        note(f"  grant {clean(grant['id'], 40)} stays live until {clean(grant.get('expires_at'), 40)}, "
             f"so its uploads still land.")
    note(f"  resume:  {fetch_hint(a, job, poll, grant)}" + ("   (downloads, then revokes the grant)" if grant else ""))
    if grant:
        note(f"  or revoke it now:  {c.revoke_hint(grant['id'])}")


def stopped_note(c, a, job, poll, grant, signame):
    """SIGTERM or SIGHUP while waiting: the grant is revoked (signals ignored meanwhile), then the hint."""
    note(f"\n{PROG}: stopped by {signame}. Job {job} carries on at the service.")
    if grant:
        note(f"  revoking grant {clean(grant['id'], 40)}: the job's uploads to the plane will fail.")
        revoke(c, grant)
    note(f"  resume:  {fetch_hint(a, job, poll)}")


def interrupted_note(c, a, job, poll, grant):
    """Ctrl-C while waiting keeps the grant: someone chose to leave the job running. A SIGTERM or
    SIGHUP with it (a closing terminal, a supervisor, timeout) means sc-job is being shut down,
    perhaps with no one to read the hint: that wins, and the grant is revoked as for SIGTERM alone.
    It is decided once, and what is printed holds: the stops are blocked first, so one that comes
    after the decision stays blocked and is dropped at exit. A stop whose handler has run, or that
    is pending, wins. Order is as delivered and handled, which needn't be the order sent."""
    stops = {s for s in (getattr(signal, n, None) for n in ("SIGTERM", "SIGHUP"))
             if s is not None and signal.getsignal(s) != signal.SIG_IGN}
    signal.pthread_sigmask(signal.SIG_BLOCK, stops)
    pending = sorted(stops & signal.sigpending())
    stop = _SIGNALS["stop"] or (signal.Signals(pending[0]).name if pending else None)
    if stop:
        stopped_note(c, a, job, poll, grant, stop)
    else:
        kept_note(c, a, job, poll, grant, "stopped waiting")



def cmd_call(c, a):
    base = service_base(c, a.service)
    submit = safe_path(a.path, "submit path")
    body = read_body(a.body)
    if a.store and not isinstance(body, dict):
        die("--store needs BODY to be a JSON object, to carry the grant")
    grant, keep = None, False
    try:
        if a.store:
            grant = c.call("POST", f"{c.api}/grants",
                           {"service_id": a.service, "group_scope": a.store, "ttl_s": a.ttl},
                           what="minting the grant")
            body["grant"] = grant["grant"]
        sub = c.call("POST", base + submit, body, what=f"submitting to {a.service}")
        job = job_id(sub.get("job"))
        poll = safe_path(sub["poll"], "poll path") if sub.get("poll") else f"/jobs/{job}"
        note(f"{PROG}: job {job} submitted to {clean(a.service)}" + (f", storing into {clean(a.store)}" if a.store else ""))
        if a.no_wait:
            print(job)
            if grant:
                keep = True
                note(f"grant {clean(grant['id'], 40)} stays live until {clean(grant.get('expires_at'), 40)}; "
                     f"to wait, download and revoke it:\n  {fetch_hint(a, job, poll, grant)}\n"
                     f"or revoke it now:\n  {c.revoke_hint(grant['id'])}")
            return 0
        try:
            j = wait(c, base, poll, job)
        except KeyboardInterrupt:
            keep = True                    # interrupted_note revokes it if a SIGTERM came too
            interrupted_note(c, a, job, poll, grant)
            return 2
        except PollLost as e:
            keep = True
            kept_note(c, a, job, poll, grant, f"stopped waiting: {e}; nothing was revoked")
            return 2
        except Stopped as e:
            keep = True                    # stopped_note revokes it, with signals ignored
            stopped_note(c, a, job, poll, grant, e.signame)
            raise
    finally:
        if grant and not keep:
            revoke(c, grant)
    return finish(c, a, base, poll, job, j)


def cmd_fetch(c, a):
    base = service_base(c, a.service)
    job = job_id(a.job)
    poll = safe_path(a.poll, "poll path") if a.poll else f"/jobs/{job}"
    grant = {"id": a.grant, "expires_at": "its ttl"} if a.grant is not None else None
    keep = False
    try:
        try:
            j = wait(c, base, poll, job)
        except KeyboardInterrupt:
            keep = True
            interrupted_note(c, a, job, poll, grant)
            return 2
        except PollLost as e:
            keep = True
            kept_note(c, a, job, poll, grant, f"stopped waiting: {e}; nothing was revoked")
            return 2
        except Stopped as e:
            keep = True
            stopped_note(c, a, job, poll, grant, e.signame)
            raise
        return finish(c, a, base, poll, job, j)
    finally:
        if grant and not keep:
            revoke(c, grant)


