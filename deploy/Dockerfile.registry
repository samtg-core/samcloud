FROM python:3.10-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-client lsof && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY registry/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY registry/*.py ./
COPY registry/schema.sql ./
COPY registry/bootstrap.sh ./
COPY registry/bootstrap.ps1 ./
COPY registry/resource-bootstrap.sh ./
COPY registry/helpers/ ./helpers/
COPY registry/skills/ ./skills/
# The release the API names (scope v1 train 2; codex, doc 260 §5: a reader could
# not pin a response to a build): the version post-merge assigned to this build and
# the commit it was built from. Both come from the deploy host; `dev` anywhere else.
ARG SAMCLOUD_VERSION=dev
ARG GIT_COMMIT=unknown
ENV SAMCLOUD_VERSION=$SAMCLOUD_VERSION
ENV SAMCLOUD_COMMIT=$GIT_COMMIT

RUN mkdir -p /data/keys

EXPOSE 7777

CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7777", "--log-level", "info"]
