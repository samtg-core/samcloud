# samcloud control plane: copy to .env, then
#   docker compose --env-file .env up -d --build
# Every line is optional unless it says otherwise.

# --- Where this plane is reached (required) ---
# The URL people and agents use. A LAN address works for a first run: the
# registry's port, as here. The dashboard is then at CONSOLE_PORT on the same
# address, and each service gets its own port from the route range below.
PUBLIC_URL=http://192.0.2.10:7778
# Host devices dial for their reverse tunnel. Defaults to PUBLIC_URL's host.
# (Older env files call it SLICE_HOST; that name is still read.)
PLANE_HOST=
# Site address for the bundled Caddy's console and API. `:443` (no name) serves any
# name or address with a certificate from Caddy's own CA; a domain gets a public one.
CONSOLE_DOMAIN=:443

# --- Dashboard sessions (required) ---
# Generate with: openssl rand -hex 32. Compose refuses to start without it.
AUTH_SECRET=

# --- Ports published on this machine ---
REGISTRY_PORT=7778
CONSOLE_PORT=3010
HTTPS_PORT=8444
HTTP_PORT=9080
SSH_PORT=2200
SSLH_PORT=9443
TUNNEL_RANGE_START=10001
TUNNEL_RANGE_END=10099
FORWARD_RANGE_START=18001
FORWARD_RANGE_END=18099
# Services' own ports when PUBLIC_URL is an IP address and SAMCLOUD_DOMAIN is unset.
ROUTE_RANGE_START=18101
ROUTE_RANGE_END=18110

# --- Names ---
# Parent domain for service subdomains. Unset, services go under PUBLIC_URL's
# host, or, when that host is an IP address, on their own ports.
SAMCLOUD_DOMAIN=
# The environment's name (shown to helpers; `staging` marks a staging plane).
SAMCLOUD_ENV=prod
# Planes the helpers' --plane can name: name=url,name=url. Unset, only this one.
SAMCLOUD_PLANES=
# The code's repository, owner/name, as the contributing skill names it. Unset, OWNER/samcloud.
SAMCLOUD_REPO=
# The seat skill pages tell agents to file problems to. Unset, the first admin user.
SAMCLOUD_ADMIN_SEAT=
# The operator's time zone (IANA name, e.g. Europe/London) for "now" and recurring tasks. Unset, UTC.
OPERATOR_TZ=

# --- Optional modules ---
# Comma-separated, or `none`. Unset, dns-namecheap is on when its credentials are set.
SAMCLOUD_MODULES=
# dns-namecheap: one DNS record per service subdomain, plus DNS-01 certificates.
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=

# --- TLS (Caddy) ---
ACME_EMAIL=
ACME_CA=
